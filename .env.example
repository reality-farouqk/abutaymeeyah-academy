# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's already in .gitignore.

# Flutterwave
FLUTTERWAVE_CLIENT_ID=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_SECRET_HASH=

# Paystack
PAYSTACK_SECRET_KEY=

# Public site URL used to build payment redirect/callback links and SEO tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin panel (/admin) — see README "Admin access" section
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Resend (contact form) — see README "Contact form" section
RESEND_API_KEY=
# Defaults to Resend's shared onboarding@resend.dev sender until you verify
# your own domain in the Resend dashboard.
RESEND_FROM_EMAIL=
# Defaults to the academy's email in lib/site-config.ts if left blank.
CONTACT_TO_EMAIL=
